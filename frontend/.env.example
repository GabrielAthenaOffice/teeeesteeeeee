# Base URL da API (backend-golang).
# Deixe VAZIO em desenvolvimento: o proxy do Vite (vite.config.js) encaminha
# /api e /health para o backend e evita CORS.
VITE_API_BASE_URL=

# Alternativa (sem proxy / produção):
# VITE_API_BASE_URL=http://localhost:8082

# Alvo do proxy em dev (padrão: http://localhost:8082 = PORT do backend-golang/.env)
# VITE_API_PROXY_TARGET=http://localhost:8082
